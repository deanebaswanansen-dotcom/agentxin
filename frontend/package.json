    "@vitejs/plugin-react": "4.3.4",
    "fast-check": "3.23.1",
    "jsdom": "25.0.1",
    "playwright": "^1.60.0",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
