LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace_me
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=120000

# Frontend build flag. Production defaults to hidden when this is omitted.
# Use VITE_SCRIPT_MODE_ENABLED=true only for browsers included in the short-drama rollout.
VITE_SCRIPT_MODE_ENABLED=false

# Public web deployment: one isolated library per browser.
REQUIRE_CLIENT_ID=1
CLIENT_DATA_DIR=data/clients

NOVEL_AGENT_PROVIDER=deepseek
NOVEL_AGENT_MODEL=deepseek-v4-pro
NOVEL_AGENT_BASE_URL=https://api.deepseek.com
NOVEL_AGENT_API_KEY=replace_me
NOVEL_AGENT_TIMEOUT_SECONDS=120
NOVEL_AGENT_MAX_RETRIES=3
NOVEL_AGENT_TEMPERATURE=0.75
NOVEL_AGENT_MAX_TOKENS=4096
NOVEL_AGENT_STREAM=true
NOVEL_AGENT_PROJECT_DIR=projects/example_novel
NOVEL_AGENT_LOG_LEVEL=INFO
